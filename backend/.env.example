# development | production. Production refuses the default JWT secret and
# SQLite, and never auto-creates tables (run `alembic upgrade head`).
ENVIRONMENT=development

DATABASE_URL=sqlite:///./tradeflow.db
# Production (PostgreSQL, e.g. Neon/Supabase/Koyeb/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/tradeflow

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# false = invite-only: owners add staff through /team, no public sign-up.
ALLOW_SIGNUP=true

# Munshi AI - only needed to actually call the LLM; everything else works without it.
OPENAI_API_KEY=

# One origin, or several separated by commas.
FRONTEND_ORIGIN=http://localhost:3000
